# Copy to .env and fill in. With no key the server runs in mock mode.
TYPESAFE_API_KEY=

# mock | live. Defaults to live when a key is set, mock otherwise.
JEV_MODE=

# Overrides for the live client.
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Hard ceiling on model calls per server process (or per bench run).
MAX_CALLS=1500

# Simulated latency of the mock model, in ms.
MOCK_LATENCY_MS=120

PORT=5173
